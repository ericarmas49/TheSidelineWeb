{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cd figma-export && npm install && npm run build",
  "outputDirectory": "figma-export/dist",
  "installCommand": "",
  "framework": null,
  "rewrites": [
    { "source": "/contact-us", "destination": "/contact-us/index.html" },
    { "source": "/contact-us/", "destination": "/contact-us/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/privacy/", "destination": "/privacy/index.html" },
    { "source": "/terms-of-service", "destination": "/terms-of-service/index.html" },
    { "source": "/terms-of-service/", "destination": "/terms-of-service/index.html" },
    { "source": "/cookie-notice", "destination": "/cookie-notice/index.html" },
    { "source": "/cookie-notice/", "destination": "/cookie-notice/index.html" },
    {
      "source": "/((?!api/|privacy|terms-of-service|cookie-notice|contact-us|favicon\\.png|\\.well-known/|styles\\.css|contact-modal\\.js|screenshots/|club-publication-excludes\\.json).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|gif|webp|svg|ico|woff2?)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
